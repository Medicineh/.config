{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "cachyos",
    "padding": {
      "right": 4
    }
  },

  "display": {
    "separator": ": "
  },

  "modules": [

    "break",

    {
      "type": "title",
      "color": {
        "user": "blue",
        "at": "white",
        "host": "cyan"
      }
    },

    "break",

    {
      "type": "custom",
      "format": "┌────────── Hardware ──────────┐"
    },

    {
      "type": "cpu",
      "key": " CPU"
    },

    {
      "type": "gpu",
      "key": "󰍛 GPU"
    },

    {
      "type": "memory",
      "key": "󰑭 RAM"
    },

    {
      "type": "battery",
      "key": "󰁹 Battery"
    },

    {
      "type": "localip",
      "key": "󰩟 IP"
    },

    {
      "type": "disk",
      "key": " Disk",
      "folders": "/"
    },

    {
      "type": "custom",
      "format": "└──────────────────────────────┘"
    },

    "break",

    {
      "type": "custom",
      "format": "┌────────── Software ──────────┐"
    },

    {
      "type": "os",
      "key": "󰣇 OS"
    },

    {
      "type": "kernel",
      "key": "󰒋 Kernel"
    },

    {
      "type": "packages",
      "key": "󰏖 Packages"
    },

    {
      "type": "shell",
      "key": " Shell"
    },

    {
      "type": "de",
      "key": "󰧨 DE"
    },

    {
      "type": "wm",
      "key": "󱂬 WM"
    },

    {
      "type": "terminal",
      "key": " Terminal"
    },

    {
      "type": "custom",
      "format": "└──────────────────────────────┘"
    },

    "break",

    {
      "type": "custom",
      "format": "┌────── Uptime / Age / DT ─────┐"
    },

    {
      "type": "command",
      "key": "󱦟 OS Age",
      "text": "birth=$(stat -c %W / 2>/dev/null); case \"$birth\" in \"\"|0|*[!0-9]*) echo Unknown ;; *) echo \"$(( ($(date +%s) - birth) / 86400 )) days\" ;; esac"
    },

    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },

    {
      "type": "datetime",
      "key": "󰃰 DateTime"
    },

    {
      "type": "custom",
      "format": "└──────────────────────────────┘"
    },

    "break",

    {
      "type": "colors",
      "paddingLeft": 2
    }
  ]
}
