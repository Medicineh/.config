### MOD

set $mod Mod4

### FLEXI 2017 ###


### WORKSPACES

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

### APPS

set $term kitty
set $menu wofi --show drun
set $fm dolphin

### WALLPAPER

output * bg /home/medicine/Imágenes/wallpaper.jpg fill

### AUTOSTART

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

exec autotiling
exec gammastep
exec nm-applet
exec blueman-applet
exec mako

exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

exec swaymsg workspace $ws1
exec firefox
exec steam -silent
exec $term --class startup-terminal
exec discord
exec sh -c "sleep 3; swaymsg workspace $ws1"

exec_always sh -c "pkill waybar; sleep 1; waybar -c ~/.config/waybar/config"

### GTK

exec gsettings set org.gnome.desktop.interface gtk-theme Breeze-Dark
exec gsettings set org.gnome.desktop.interface color-scheme prefer-dark

### INPUT

input type:keyboard {
xkb_layout es
}

### APPEARANCE

gaps inner 10
gaps outer 8

default_border pixel 2

client.focused          #89b4fa #89b4fa #1e1e2e #89b4fa
client.focused_inactive #45475a #45475a #cdd6f4 #45475a
client.unfocused        #313244 #313244 #cdd6f4 #313244
client.urgent           #f38ba8 #f38ba8 #1e1e2e #f38ba8

### TERMINAL

bindsym $mod+Return exec $term

### SCRATCHPAD

bindsym $mod+c exec kitty --class scratchpad
bindsym $mod+Shift+c scratchpad show

for_window [app_id="scratchpad"] floating enable
for_window [app_id="scratchpad"] resize set width 75 ppt height 75 ppt
for_window [app_id="scratchpad"] move position center
for_window [app_id="scratchpad"] move scratchpad

### LAUNCHER

bindsym $mod+d exec $menu

### FILE MANAGER

bindsym $mod+e exec $fm

### CLOSE WINDOW

bindsym $mod+q kill

### RELOAD

bindsym $mod+Ctrl+r reload

### EXIT

bindsym $mod+Shift+e exec swaynag -t warning -m "Salir de Sway?" -B "Sí" "swaymsg exit"

### LOCK

bindsym $mod+l exec swaylock

### FOCUS

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

### MOVE WINDOWS

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### FLOATING

floating_modifier $mod

bindsym $mod+space floating toggle
bindsym $mod+Shift+space focus mode_toggle

### RESIZE

mode "resize" {
bindsym Left resize shrink width 10 px
bindsym Right resize grow width 10 px
bindsym Up resize shrink height 10 px
bindsym Down resize grow height 10 px

bindsym Return mode "default"
bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

### LAYOUTS

bindsym $mod+v splitv
bindsym $mod+b splith

bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split

### WORKSPACES

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

### MOVE TO WORKSPACE

bindsym $mod+Ctrl+1 move container to workspace $ws1
bindsym $mod+Ctrl+2 move container to workspace $ws2
bindsym $mod+Ctrl+3 move container to workspace $ws3
bindsym $mod+Ctrl+4 move container to workspace $ws4
bindsym $mod+Ctrl+5 move container to workspace $ws5
bindsym $mod+Ctrl+6 move container to workspace $ws6
bindsym $mod+Ctrl+7 move container to workspace $ws7
bindsym $mod+Ctrl+8 move container to workspace $ws8
bindsym $mod+Ctrl+9 move container to workspace $ws9
bindsym $mod+Ctrl+0 move container to workspace $ws10

### AUTO WORKSPACES

assign [app_id="firefox"] workspace $ws1
assign [class="Firefox"] workspace $ws1
assign [class="Steam"] workspace $ws1
assign [app_id="steam"] workspace $ws1
assign [app_id="startup-terminal"] workspace $ws2
assign [app_id="discord"] workspace $ws2
assign [class="discord"] workspace $ws2
assign [class="Discord"] workspace $ws2

### SCREENSHOT

bindsym Print exec grim -g "$(slurp)" - | wl-copy

### AUDIO

bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

### MEDIA

bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

### BRIGHTNESS

bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

### WAYBAR

bindsym $mod+Shift+w exec pkill waybar && waybar -c ~/.config/waybar/config

### FLOATING WINDOWS

for_window [window_role="dialog"] floating enable
for_window [window_role="pop-up"] floating enable

### IDLE

exec swayidle -w \
    timeout 300 'swaylock' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock'
