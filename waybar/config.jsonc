{
"layer": "top",
"position": "top",
"height": 34,

"modules-left": [
"sway/workspaces"
],

"modules-center": [
"clock"
],

"modules-right": [
"pulseaudio",
"backlight",
"battery",
"cpu",
"memory",
"tray"
],

"sway/workspaces": {
"disable-scroll": true,
"all-outputs": true
},

"clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%I:%M %p}",
    "tooltip-format": "{:%A %d %B %Y}",
    "on-click-right": "waybar-msg module clock toggle"
}

"cpu": {
"format": " {usage}%"
},

"memory": {
"format": "󰍛 {}%"
},

"battery": {
"format": "{capacity}% ",
"format-charging": "{capacity}% "
},

"backlight": {
"format": "{percent}% ☀"
},

"pulseaudio": {
"format": "{volume}% ",
"format-muted": "󰝟"
},

"tray": {
"spacing": 10
}
}
