{
    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 6,

    "modules-left": [
        "custom/launcher",
        "sway/workspaces",
        "bluetooth",
        "network"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "power-profiles-daemon",
        "pulseaudio",
        "battery",
        "tray"
    ],

    "custom/launcher": {
        "format": "",
        "on-click": "wofi --show drun",
        "tooltip": false
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "clock": {
        "format": "  {:%H:%M}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>",
        "interval": 1
    },

    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "󰈀 Connected",
        "format-disconnected": "󰖪 Offline",
        "tooltip-format": "{essid} - {ipaddr}",
        "on-click": "nm-connection-editor",
        "on-click-right": "kitty -e nmtui"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": " {device_alias}",
        "tooltip-format": "{controller_alias}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },

        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",

        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],

        "tooltip-format": "{timeTo} remaining"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power mode: {profile}",

        "format-icons": {
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰌪"
        },

        "on-click": "powerprofilesctl set performance",
        "on-click-right": "powerprofilesctl set balanced",
        "on-click-middle": "powerprofilesctl set power-saver"
    },

    "tray": {
        "spacing": 10
    }
}
